# ==============================================================================
# Gnani.ai Company Knowledge Assistant - Environment Configuration
# ==============================================================================
# Obtain your free API key at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key

# Supported Groq Models:
# - llama-3.3-70b-versatile (Recommended: High-reasoning and grounding)
# - llama-3.1-8b-instant (Fast: Low-latency responses)
GROQ_MODEL=llama-3.3-70b-versatile

# Lightweight Hugging Face Embeddings (Local CPU execution)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Number of relevant chunks retrieved per query
TOP_K=4
